<Window x:Class="FolderOrganiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FolderOrganiser"
        mc:Ignorable="d"
        Title="Folder Organiser" Height="450" Width="800"
        xmlns:vm="clr-namespace:FolderOrganiser.ViewModels">
    <Window.DataContext>
        <vm:CoreViewModel/>
    </Window.DataContext>
    <Grid>
        <Button Content="Choose Path" Click="Button_Click" Width="200" Height="75"></Button>
        <TextBlock Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Height="50" Width="500"></TextBlock>
    </Grid>
</Window>
